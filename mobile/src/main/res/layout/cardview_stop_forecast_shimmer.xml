<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardview_stop_forecast"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="5dp"
    app:cardCornerRadius="@dimen/cardview_laag_corner_radius">

    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmer_stop_forecast"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/stop_forecast_row_min_height"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/constraintlayout_shimmer_due_time_details"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/shimmer_stop_name_line"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toTopOf="@id/shimmer_reminder_text_line"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/shimmer_reminder_text_line"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/shimmer_stop_name_line" />

                <View
                    android:id="@+id/shimmer_stop_name"
                    android:layout_width="200dp"
                    android:layout_height="16dp"
                    android:background="@drawable/shimmer_gradient"
                    app:layout_constraintBottom_toBottomOf="@id/shimmer_stop_name_line"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/shimmer_stop_name_line" />

                <View
                    android:id="@+id/shimmer_reminder_text"
                    android:layout_width="120dp"
                    android:layout_height="12dp"
                    android:background="@drawable/shimmer_gradient"
                    app:layout_constraintBottom_toBottomOf="@id/shimmer_reminder_text_line"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/shimmer_reminder_text_line" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/constraintlayout_shimmer_due_time_details"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="12dp"
                android:minWidth="@dimen/stop_forecast_due_time_min_width"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/shimmer_minutes_line"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toTopOf="@id/shimmer_mins_text_line"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/shimmer_mins_text_line"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/shimmer_minutes_line" />

                <View
                    android:id="@+id/shimmer_minutes"
                    android:layout_width="24dp"
                    android:layout_height="16dp"
                    android:background="@drawable/shimmer_solid"
                    app:layout_constraintBottom_toBottomOf="@id/shimmer_minutes_line"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/shimmer_minutes_line" />

                <View
                    android:id="@+id/shimmer_mins_text"
                    android:layout_width="24dp"
                    android:layout_height="12dp"
                    android:background="@drawable/shimmer_solid"
                    app:layout_constraintBottom_toBottomOf="@id/shimmer_mins_text_line"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/shimmer_mins_text_line" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>
</com.google.android.material.card.MaterialCardView>
