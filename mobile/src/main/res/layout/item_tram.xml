<?xml version="1.0" encoding="utf-8"?>
<!--
    The height here is a starting point, not a commitment. The layout_weight means LinearLayout shares out the difference between
    the sum of these heights and the height trams_container really has, growing or shrinking every row equally, so the last row is
    never half drawn. See stop_forecast_widget.xml. The base height is deliberately not 0dp: if the weight were ever ignored the
    rows would fall back to a sensible fixed height rather than vanishing.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/widget_tram_item_height"
    android:layout_weight="1"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp">

    <TextView
        android:id="@+id/tram_destination"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/on_surface" />

    <TextView
        android:id="@+id/tram_due_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/on_surface" />

</LinearLayout>
