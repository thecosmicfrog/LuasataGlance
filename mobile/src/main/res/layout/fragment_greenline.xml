<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:id="@+id/constraintlayout_fragment_greenline"
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"

    tools:context="org.thecosmicfrog.luasataglance.activity.MainActivity$LineFragment">

    <Space
        android:id="@+id/greenline_space1"
        android:layout_width="0dp"
        android:layout_height="2dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/greenline_progressbar"
        app:layout_constraintStart_toStartOf="parent"/>

    <ProgressBar
        android:id="@+id/greenline_progressbar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:indeterminateOnly="true"
        app:layout_constraintBottom_toTopOf="@id/greenline_space2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/greenline_space1" />

    <Space
        android:id="@+id/greenline_space2"
        android:layout_width="0dp"
        android:layout_height="2dp"
        app:layout_constraintTop_toBottomOf="@id/greenline_progressbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/greenline_linearlayout_top_portion"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/greenline_linearlayout_top_portion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/activity_horizontal_margin"
        android:layout_marginEnd="@dimen/activity_horizontal_margin"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/greenline_swiperefreshlayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/greenline_space2">

        <org.thecosmicfrog.luasataglance.view.SpinnerCardView
            android:id="@+id/greenline_spinner_card_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="@dimen/cardview_laag_corner_radius" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="12dp" />

        <org.thecosmicfrog.luasataglance.view.StatusCardView
            android:id="@+id/greenline_statuscardview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="@dimen/cardview_laag_corner_radius" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="7.2dp" />

        <org.thecosmicfrog.luasataglance.view.TutorialCardView
            android:id="@+id/tutorialcardview_select_stop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardCornerRadius="@dimen/cardview_laag_corner_radius" />

        <org.thecosmicfrog.luasataglance.view.TutorialCardView
            android:id="@+id/tutorialcardview_notifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardCornerRadius="@dimen/cardview_laag_corner_radius" />

        <org.thecosmicfrog.luasataglance.view.TutorialCardView
            android:id="@+id/tutorialcardview_favourites"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardCornerRadius="@dimen/cardview_laag_corner_radius" />
    </LinearLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/greenline_swiperefreshlayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/greenline_linearlayout_top_portion"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/greenline_scrollview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:requiresFadingEdge="vertical"
            android:fadingEdgeLength="32dp"
            android:paddingBottom="56dp"
            android:paddingLeft="@dimen/activity_horizontal_margin"
            android:paddingRight="@dimen/activity_horizontal_margin">

            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="4.8dp" />

                <org.thecosmicfrog.luasataglance.view.StopForecastConstraintLayout
                    android:id="@+id/greenline_stopforecastconstraintlayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="64dp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
