<!--
    Explicit theme needed here, otherwise app crashes, because... reasons...:
    https://stackoverflow.com/a/63797256
 -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:theme="@style/LuasAtAGlanceDialogContent"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    android:paddingBottom="@dimen/activity_vertical_margin">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/notify_when"
        android:textColor="@color/on_surface"
        android:textStyle="bold"
        android:paddingTop="8dp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="16dp" />

    <com.google.android.material.card.MaterialCardView
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="@dimen/cardview_laag_elevation"
        app:cardCornerRadius="@dimen/cardview_laag_corner_radius">

        <org.thecosmicfrog.luasataglance.view.LaagSpinner
            android:id="@+id/spinner_notifytime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:spinnerMode="dropdown"
            android:popupBackground="@drawable/spinner_background" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/textview_notifytime_replaces_existing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="16dp"
        android:text="@string/notify_replaces_existing"
        android:textColor="@color/text_error"
        android:textStyle="bold"
        android:visibility="gone" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="24dp" />

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="1"
        android:baselineAligned="true">

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.5" />

        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.5">

            <Button
                android:id="@+id/button_notifytime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:background="@drawable/laag_button"
                android:elevation="@dimen/cardview_laag_elevation"
                android:text="@string/notify_set"
                android:textColor="@color/text_on_accent" />
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
