<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/whatsnew_item_spacing"
    android:orientation="horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/whatsnew_bullet_gap"
        android:text="@string/whatsnew_bullet"
        android:textColor="@color/on_surface"
        android:textSize="@dimen/whatsnew_text_size" />

    <TextView
        android:id="@+id/textview_whatsnew_item"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/on_surface"
        android:textSize="@dimen/whatsnew_text_size" />
</LinearLayout>
