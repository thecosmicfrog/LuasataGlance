<resources>
    <!--
        Every parent here is a DayNight variant.
    -->
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Where Material's own components read text colour. -->
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>

        <!-- Material's own `textColorPrimary` ignores `colorOnSurface`, so these are needed too. -->
        <item name="android:textColorPrimary">@color/on_surface</item>
        <item name="android:textColorSecondary">@color/on_surface_variant</item>
        <item name="android:textColorTertiary">@color/on_surface_variant</item>

        <!-- Also cancels Material3's elevation tint, so a card is exactly `background_card`. -->
        <item name="colorPrimary">@color/background_card</item>
        <item name="colorSurface">@color/background_card</item>

        <!-- The permission dialog's buttons take their colour from here. -->
        <item name="colorAccent">@color/icon_accent</item>

        <!-- Hack to change SettingsActivity toolbar color and back button to white. -->
        <item name="toolbarStyle">@style/toolbar_settings</item>
        <item name="colorControlNormal">@color/text_on_bars</item>

        <item name="floatingActionButtonStyle">
            @style/LuasAtAGlanceFloatingActionButton
        </item>

        <item name="extendedFloatingActionButtonStyle">
            @style/LuasAtAGlanceExtendedFloatingActionButton
        </item>

        <item name="snackbarStyle">@style/LuasAtAGlanceSnackbar</item>
        <item name="snackbarTextViewStyle">@style/LuasAtAGlanceSnackbarTextView</item>
    </style>

    <style name="toolbar_settings" parent="@style/Widget.AppCompat.Toolbar">
        <item name="titleTextColor">@color/text_on_bars</item>
    </style>

    <style name="LuasAtAGlanceTabLayout" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Keep the AppCompat parent. A Material3 one turns AboutActivity's links white on white. -->
    <style name="LuasAtAGlancePopupDialog" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="android:windowBackground">@drawable/popup_dialog_background</item>

        <item name="windowFixedWidthMajor">80%</item>
        <item name="windowFixedWidthMinor">80%</item>

        <item name="android:windowMinWidthMajor">80%</item>
        <item name="android:windowMinWidthMinor">80%</item>

        <item name="windowNoTitle">true</item>
    </style>

    <!-- About, What's New, and Settings. Each of their layouts holds its own card, so the window behind it draws nothing. -->
    <style name="LuasAtAGlanceCardDialog" parent="LuasAtAGlancePopupDialog">
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <style name="LuasAtAGlanceSettingsDialog" parent="LuasAtAGlanceCardDialog">
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>
        <item name="alertDialogTheme">@style/LuasAtAGlanceAlertDialog</item>

        <item name="android:listPreferredItemPaddingStart">0dp</item>
        <item name="android:listPreferredItemPaddingLeft">0dp</item>
    </style>

    <style name="LuasAtAGlanceAlertDialog" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="colorAccent">@color/icon_accent</item>
        <item name="colorBackgroundFloating">@color/background_card</item>
        <item name="dialogCornerRadius">@dimen/cardview_laag_corner_radius</item>
    </style>

    <!--
        MaterialCardView will not inflate under AppCompat. Applied whole rather than as a
        `ThemeOverlay`, so text in those four layouts has to name its own colour.
    -->
    <style name="LuasAtAGlanceDialogContent" parent="Theme.MaterialComponents.DayNight.Bridge">
        <!-- The Bridge theme's own dark greys are neutral, not purple-tinted. No-ops in light mode. -->
        <item name="colorSurface">@color/background_card</item>
        <item name="elevationOverlayEnabled">false</item>
    </style>

    <style name="AppTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="LuasAtAGlanceActionBar" parent="@style/Widget.AppCompat.Light.ActionBar.Solid.Inverse">
        <item name="android:background">@color/background_appbar</item>
        <item name="background">@color/background_appbar</item>
    </style>

    <!-- "Pointer" at bottom of custom Google Maps info window. -->
    <style name="MapsInfoWindowPointer" parent="Widget.MaterialComponents.CardView">
        <item name="shapeAppearanceOverlay">@style/MapsInfoWindowPointerShape</item>
    </style>

    <style name="MapsInfoWindowPointerShape" parent="@style/Widget.MaterialComponents.CardView">
        <item name="cornerFamily">cut</item>
        <item name="cornerSizeTopRight">0dp</item>
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeBottomRight">15dp</item>
        <item name="cornerSizeBottomLeft">15dp</item>
    </style>

    <style name="LuasAtAGlanceBottomNavigationBarActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/background_navbar_indicator</item>
    </style>

    <style name="LuasAtAGlancePermissionsRequestDialog" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="android:background">@color/background_card</item>
        <item name="android:textColorPrimary">@color/on_surface</item>
        <item name="android:textColorSecondary">@color/on_surface_variant</item>
        <item name="android:windowFrame">@null</item>
    </style>

    <style name="LuasAtAGlanceRationaleDialog" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="android:textColorPrimary">@color/on_surface</item>
        <item name="colorAccent">@color/icon_accent</item>
        <item name="buttonBarPositiveButtonStyle">@style/LuasAtAGlanceRationaleDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/LuasAtAGlanceRationaleDialogButton</item>
    </style>

    <style name="LuasAtAGlanceRationaleDialogButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/icon_accent</item>
    </style>

    <!-- The save button on Select Favourites is the exception, tinted green by `StopSelectActivity`. -->
    <style name="LuasAtAGlanceFloatingActionButton" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/background_accent</item>
    </style>

    <style name="LuasAtAGlanceExtendedFloatingActionButton" parent="Widget.Material3.ExtendedFloatingActionButton.Primary">
        <item name="backgroundTint">@color/background_accent</item>

        <item name="android:textColor">@color/text_on_accent</item>
        <item name="iconTint">@color/text_on_accent</item>
    </style>

    <style name="LuasAtAGlanceSnackbar" parent="Widget.Material3.Snackbar">
        <item name="backgroundTint">@color/background_accent</item>
        <item name="shapeAppearance">@style/LuasAtAGlanceSnackbarShapeAppearance</item>
    </style>

    <!-- `android:textColor` on the Snackbar style does nothing. Material reads this instead. -->
    <style name="LuasAtAGlanceSnackbarTextView" parent="Widget.Material3.Snackbar.TextView">
        <item name="android:textColor">@color/text_on_accent</item>
    </style>

    <style name="LuasAtAGlanceSnackbarShapeAppearance" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">@dimen/cardview_laag_corner_radius</item>
    </style>

    <style name="AppTheme.Welcome">
        <item name="android:windowBackground">@color/welcome_background</item>
    </style>

    <style name="LuasAtAGlanceWelcomeThemeButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/welcome_theme_button_text</item>
        <item name="backgroundTint">@color/welcome_theme_button_background</item>
        <item name="strokeColor">@color/icon_accent</item>
        <item name="rippleColor">@color/icon_accent</item>
    </style>

    <style name="LuasAtAGlanceWelcomeButton" parent="Widget.Material3.Button">
        <item name="android:textColor">@color/welcome_button_text</item>
        <item name="backgroundTint">@color/welcome_button_background</item>
        <item name="shapeAppearance">@style/LuasAtAGlanceSnackbarShapeAppearance</item>
    </style>

    <style name="LuasAtAGlancePreferenceDialogStyle" parent="Theme.Material3.DayNight.Dialog.Alert">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="dialogCornerRadius">@dimen/cardview_laag_corner_radius</item>
        <item name="android:textColorPrimary">@color/on_surface</item>
        <item name="colorAccent">@color/icon_accent</item>
    </style>
</resources>
