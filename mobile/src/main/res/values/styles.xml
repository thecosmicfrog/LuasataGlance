<resources>
    <style name="AppTheme" parent="Theme.Material3.Light.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="android:textColor">@color/text_dark</item>

        <!-- Disable Material 3 dynamic colours. -->
        <item name="colorPrimary">@android:color/white</item>
        <item name="colorSurface">@android:color/white</item>

        <!-- Change general colour accent to the Luas shade of purple. -->
        <item name="colorAccent">@color/luas_purple</item>

        <!-- Hack to change SettingsActivity toolbar color and back button to white. -->
        <item name="toolbarStyle">@style/toolbar_settings</item>
        <item name="colorControlNormal">@android:color/white</item>

        <item name="floatingActionButtonStyle">
            @style/LuasAtAGlanceFloatingActionButton
        </item>

        <item name="extendedFloatingActionButtonStyle">
            @style/LuasAtAGlanceExtendedFloatingActionButton
        </item>

        <item name="snackbarStyle">@style/LuasAtAGlanceSnackbar</item>
    </style>

    <style name="toolbar_settings" parent="@style/Widget.AppCompat.Toolbar">
        <item name="titleTextColor">@android:color/white</item>
    </style>

    <style name="LuasAtAGlanceTabLayout" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="LuasAtAGlancePopupDialog" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/popup_dialog_background</item>
    </style>

    <style name="AppTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="LuasAtAGlanceActionBar" parent="@style/Widget.AppCompat.Light.ActionBar.Solid.Inverse">
        <item name="android:background">@color/luas_purple</item>
        <item name="background">@color/luas_purple</item>
    </style>

    <!-- "Pointer" at bottom of custom Google Maps info window. -->
    <style name="MapsInfoWindowPointer" parent="Widget.MaterialComponents.CardView">
        <item name="shapeAppearanceOverlay">@style/MapsInfoWindowPointerShape</item>
    </style>

    <style name="MapsInfoWindowPointerShape" parent="@style/Widget.MaterialComponents.CardView">
        <item name="cornerFamily">cut</item>
        <item name="cornerSizeTopRight">0dp</item>
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeBottomRight">15dp</item>
        <item name="cornerSizeBottomLeft">15dp</item>
    </style>

    <style name="LuasAtAGlanceBottomNavigationBarActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/luas_purple_light</item>
    </style>

    <style name="LuasAtAGlancePermissionsRequestDialog" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:background">#FFFFFF</item>
        <item name="android:textColorPrimary">#000000</item>
        <item name="android:textColorSecondary">#000000</item>
        <item name="android:windowFrame">@null</item>
    </style>

    <style name="LuasAtAGlanceFloatingActionButton" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/message_warning</item>
    </style>

    <style name="LuasAtAGlanceExtendedFloatingActionButton" parent="Widget.Material3.ExtendedFloatingActionButton.Primary">
        <item name="backgroundTint">@color/message_warning</item>
    </style>

    <style name="LuasAtAGlanceSnackbar" parent="Widget.Material3.Snackbar">
        <item name="backgroundTint">@color/luas_purple</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="shapeAppearance">@style/LuasAtAGlanceSnackbarShapeAppearance</item>
    </style>

    <style name="LuasAtAGlanceSnackbarShapeAppearance" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">@dimen/cardview_laag_corner_radius</item>
    </style>

    <style name="LuasAtAGlancePreferenceDialogStyle" parent="Theme.Material3.Light.Dialog.Alert">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="dialogCornerRadius">@dimen/cardview_laag_corner_radius</item>
        <item name="android:textColor">@color/text_dark</item>
        <item name="colorAccent">@color/luas_purple</item>
    </style>
</resources>

