<resources>
    <!-- Default screen margins, per the Android Design guidelines. -->
    <dimen name="activity_horizontal_margin">16dp</dimen>
    <dimen name="activity_vertical_margin">16dp</dimen>

    <!-- Default CardView elevation, as @dimen/cardview_default_elevation is marked as private. -->
    <dimen name="cardview_laag_elevation">2dp</dimen>

    <dimen name="cardview_laag_corner_radius">12dp</dimen>

    <!-- Size floor for a tram row in cardview_stop_forecast.xml, which grows past both when the user scales text up. -->
    <dimen name="stop_forecast_row_min_height">50dp</dimen>
    <dimen name="stop_forecast_due_time_min_width">54dp</dimen>

    <dimen name="status_shimmer_bar_height">16dp</dimen>
    <dimen name="status_shimmer_bar_inset">12dp</dimen>

    <dimen name="widget_tram_item_height">28dp</dimen>
    <dimen name="widget_header_height">40dp</dimen>
    <dimen name="widget_direction_label_height">20dp</dimen>
    <dimen name="widget_direction_label_text_size">12sp</dimen>
    <dimen name="widget_reported_height_slack">16dp</dimen>

    <!--
        The welcome screen. The tram is much wider than the device it is drawn on, and `wrap_content` would cap it at the width of
        its parent and shrink it to fit, so both sides are stated. WelcomeActivity stops the tram with its nose on the card's left
        margin.
    -->
    <dimen name="welcome_stage_height">211dp</dimen>
    <dimen name="welcome_tram_height">208dp</dimen>
    <dimen name="welcome_tram_width">1142dp</dimen>
    <dimen name="welcome_track_height">3dp</dimen>

    <!-- How far the title falls as it fades in, and how far the card and button rise behind it. -->
    <dimen name="welcome_title_slide">32dp</dimen>
    <dimen name="welcome_content_rise">24dp</dimen>
</resources>
