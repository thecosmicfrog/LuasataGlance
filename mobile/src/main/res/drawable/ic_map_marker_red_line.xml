<!--
    MapLibre centres a marker icon on the stop rather than standing it on its tip, so the viewport is twice the height of the
    pin. The path ends at y=22, half of the 44 below, which drops the tip onto the centre line and puts it over the stop. The
    lower half is empty on purpose. Trimming it walks the pin back up off the stop.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="40dp"
    android:height="73.33dp"
    android:viewportWidth="24"
    android:viewportHeight="44">
    <path
        android:pathData="M12,2C8.13,2 5,5.13 5,9c0,5.25 7,13 7,13s7,-7.75 7,-13c0,-3.87 -3.13,-7 -7,-7z"
        android:fillColor="@color/tab_red_line"
        android:strokeColor="@color/map_marker_detail"
        android:strokeWidth="1.0" />
    <path
        android:pathData="M12,11.5c-1.38,0 -2.5,-1.12 -2.5,-2.5s1.12,-2.5 2.5,-2.5 2.5,1.12 2.5,2.5 -1.12,2.5 -2.5,2.5z"
        android:fillColor="@color/map_marker_detail"
        android:strokeColor="@color/map_marker_detail"
        android:strokeWidth="1.0" />
</vector>
